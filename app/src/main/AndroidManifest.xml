<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 定时岗位(2026-10-11): 精确闹钟到点唤醒 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Android 13+ 闹钟类豁免: 免用户手动授权精确闹钟, 自分发无 Play 政策限制 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 所有文件访问: 解决作用域存储下 adb push 落盘文件 owner=NULL 对 MediaStore 查询不可见的问题 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Android 11+ 包可见性: 让 app_launch 能解析第三方应用启动入口 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application android:name=".NyralApp"
        android:label="Nyral"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Nyral"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:fullBackupContent="false">

        <!-- 首启引导页作为 launcher：全新安装先看引导，点"开始授权"后进主界面 -->
        <activity
            android:name=".GuideActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.Nyral.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 主界面：由引导页或系统通知等跳入，不再直接响应桌面图标 -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Nyral.NoActionBar">
        </activity>

        <receiver
            android:name=".TaskDismissReceiver"
            android:exported="false" />

        <!-- 安全确认通知通道接收器(2026-10-04): 处理后台通知的允许/拒绝 Action -->
        <receiver
            android:name="all.SecurityConfirmReceiver"
            android:exported="false" />

        <!-- 安全审计历史页(2026-10-04): 顶栏入口, 展示 filesDir/nyral_security_audit.log -->
        <activity
            android:name=".AuditActivity"
            android:exported="false"
            android:theme="@style/Theme.Nyral.NoActionBar">
        </activity>

        <!-- 安全中心(2026-10-04): 三档门禁切换 + 审计历史入口 -->
        <activity
            android:name=".SecurityCenterActivity"
            android:exported="false"
            android:theme="@style/Theme.Nyral.NoActionBar">
        </activity>

        <!-- 文档占位页(2026-10-11): 抽屉"文档"入口占位 -->
        <activity
            android:name=".DocPlaceholderActivity"
            android:exported="false"
            android:theme="@style/Theme.Nyral.NoActionBar">
        </activity>

        <!-- 产物查看页(2026-11-02 产物通道): AI 登记产物的全屏查看/保存/分享 -->
        <activity
            android:name=".ArtifactViewerActivity"
            android:exported="false"
            android:theme="@style/Theme.Nyral.NoActionBar">
        </activity>

        <receiver
            android:name=".TaskControlReceiver"
            android:exported="false" />

        <!-- 定时岗位唤醒接收器(2026-10-11): AlarmManager 到点触发, 拉起 TaskService 静默执行 -->
        <receiver
            android:name=".TimerWakeReceiver"
            android:exported="false" />

        <!-- 定时岗位重排广播入口(2026-10-11 建, 2026-11-10 扩至多触发源):
             priority=INT_MAX 与 MacroDroid StartupReceiver 同档; QUICKBOOT 覆盖只发快速开机广播的厂商;
             TIME_SET/TIMEZONE_CHANGED 对齐 MacroDroid crashguard.SchedulerReceiver —— 改时间/换时区后
             一次性 setAlarmClock 会与实际时刻脱节, 必须重排。是否真的重排由 TimerRecovery 判据决定。 -->
        <receiver
            android:name=".TimerBootReceiver"
            android:exported="true">
            <intent-filter android:priority="2147483647">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <!-- Tasker 同款重排窗口: 装/卸任意 App 都触发一次(该 action 在 Android O 隐式广播豁免清单内),
                 重启后用户只要装点东西就可能自愈, 成本由 TimerRecovery 判据短路 -->
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- 定时岗位列表页(2026-10-11): 抽屉"定时任务"入口 -->
        <activity
            android:name=".TimerTaskActivity"
            android:exported="false"
            android:theme="@style/Theme.Nyral.NoActionBar">
        </activity>

        <!-- 岗位详情页(2026-11-14): 状态 / 目标全文 / 能力授权 / 最近台账 -->
        <activity
            android:name=".TimerTaskDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.Nyral.NoActionBar" />

        <!-- 岗位编辑页(2026-11-14): 新建与编辑共用; 目标多行输入需要键盘压缩窗口 -->
        <activity
            android:name=".TimerTaskEditActivity"
            android:exported="false"
            android:theme="@style/Theme.Nyral.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- 定时岗位保活前台服务(2026-10-11): 有启用任务时常驻通知钉住进程, 防速冻/防被杀 -->
        <service
            android:name=".TimerKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- Android 15+ dataSync 型 FGS 有 6h 运行上限, 到期抛 ForegroundServiceDidNotStopInTimeException;
                 保活服务需长期常驻, 改 specialUse(无时长配额) -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="scheduled_task_keepalive" />
        </service>

        <!-- 定时岗位重排兜底 Job(2026-11-10): persisted 周期 15min, 由 system_server 在重启后自动恢复,
             不依赖 BOOT_COMPLETED 广播投递(厂商 BootPressureHolder 拦广播但拦不住 job 恢复) -->
        <service
            android:name=".TimerBootJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- 任务执行前台服务: AI 处理任务期间防止进程被回收, dataSync 类型 -->
        <service
            android:name=".TaskService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- DebugServer 保活前台服务: 退后台防进程冻结, 仅 debug 构建启用 -->
        <service
            android:name=".DebugService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 无障碍控制服务: AI 控制第三方 App 的原型通道, 需用户在系统设置开启无障碍 -->
        <service
            android:name=".UiControlService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 设置系页面统一 NoActionBar：自绘白色标题栏（Ui.titleBar），与主页视觉一致 -->
        <activity
            android:name=".SshConfigActivity"
            android:exported="false"
            android:label="SSH 连接配置"
            android:theme="@style/Theme.Nyral.NoActionBar" />

        <activity
            android:name=".GenConfigActivity"
            android:exported="false"
            android:label="AI 生成设置"
            android:theme="@style/Theme.Nyral.NoActionBar" />

        <activity
            android:name=".GenConfigEditActivity"
            android:exported="false"
            android:label="厂商配置"
            android:theme="@style/Theme.Nyral.NoActionBar" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="设置"
            android:theme="@style/Theme.Nyral.NoActionBar" />

        <!-- 头像 1:1 自由裁剪页 -->
        <activity
            android:name=".AvatarCropActivity"
            android:exported="false"
            android:label="裁剪头像"
            android:theme="@style/Theme.Nyral.NoActionBar" />

        <activity
            android:name=".ModelConfigActivity"
            android:exported="false"
            android:label="模型配置"
            android:theme="@style/Theme.Nyral.NoActionBar" />

        <activity
            android:name=".ModelEditActivity"
            android:exported="false"
            android:label="添加模型"
            android:theme="@style/Theme.Nyral.NoActionBar" />

        <activity
            android:name=".MemModelConfigActivity"
            android:exported="false"
            android:label="记忆辅助模型"
            android:theme="@style/Theme.Nyral.NoActionBar" />

        <activity
            android:name=".MemoryListActivity"
            android:exported="false"
            android:label="长期记忆"
            android:theme="@style/Theme.Nyral.NoActionBar" />
        <activity
            android:name=".FileListActivity"
            android:exported="false"
            android:label="文件管理"
            android:theme="@style/Theme.Nyral.NoActionBar" />
        <activity
            android:name=".FileAuditActivity"
            android:exported="false"
            android:label="删除日志"
            android:theme="@style/Theme.Nyral.NoActionBar" />

        <activity
            android:name=".MemorySummaryActivity"
            android:exported="false"
            android:label="整理记忆索引"
            android:theme="@style/Theme.Nyral.NoActionBar" />

        <activity
            android:name=".LogActivity"
            android:exported="false"
            android:label="运行日志"
            android:theme="@style/Theme.Nyral.NoActionBar" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="关于"
            android:theme="@style/Theme.Nyral.NoActionBar" />

        <!-- 权限管理: 查看/补开全部依赖权限 -->
        <activity
            android:name=".TimerHealthActivity"
            android:exported="false"
            android:theme="@style/Theme.Nyral.NoActionBar" />
        <activity
            android:name=".PermissionsActivity"
            android:exported="false"
            android:label="权限管理"
            android:theme="@style/Theme.Nyral.NoActionBar" />
        <activity
            android:name=".DiagnosticsActivity"
            android:exported="false"
            android:label="手机体检"
            android:theme="@style/Theme.Nyral.NoActionBar" />
        <activity
            android:name=".FirstRunSetupActivity"
            android:exported="false"
            android:label="完成授权与设置"
            android:theme="@style/Theme.Nyral.NoActionBar" />



        <activity
            android:name=".ChatBackgroundActivity"
            android:exported="false"
            android:label="聊天背景"
            android:theme="@style/Theme.Nyral.NoActionBar" />

        <!-- 附件持久化访问: 通过 content:// 让系统查看器打开 app 私有目录里的附件文件 -->
        <provider
            android:name=".LocalFileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true" />
        <activity
            android:name=".PersonalityActivity"
            android:exported="false"
            android:label="AI 个性化"
            android:theme="@style/Theme.Nyral.NoActionBar" />
        <activity
            android:name=".UserProfileActivity"
            android:exported="false"
            android:label="我的资料"
            android:theme="@style/Theme.Nyral.NoActionBar" />
        <activity
            android:name=".AppearanceActivity"
            android:exported="false"
            android:label="外观设置"
            android:theme="@style/Theme.Nyral.NoActionBar" />

        <activity
            android:name=".McpConfigActivity"
            android:exported="false"
            android:label="MCP 服务"
            android:theme="@style/Theme.Nyral.NoActionBar" />

        <!-- AI 悬浮迷你终端前台服务: 半透明终端实时显示 AI 执行状态 -->
        <service
            android:name=".AITerminalService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name=".KnowledgeBaseActivity"
            android:exported="false"
            android:label="知识库"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Nyral.NoActionBar" />
        <activity
            android:name=".KnowledgeEntryActivity"
            android:exported="false"
            android:label="知识详情"
            android:theme="@style/Theme.Nyral.NoActionBar" />
        <activity
            android:name=".KnowledgeTrashActivity"
            android:exported="false"
            android:label="回收区"
            android:theme="@style/Theme.Nyral.NoActionBar" />
        <activity
            android:name=".KnowledgeAuditActivity"
            android:exported="false"
            android:label="变更审计"
            android:theme="@style/Theme.Nyral.NoActionBar" />


        <!-- Shizuku 授权通道: provider 必须显式声明, 否则 pingBinder 拿不到 binder(仅 adb 级, 只读) -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>
</manifest>
