<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 所有文件访问: 解决作用域存储下 adb push 落盘文件 owner=NULL 对 MediaStore 查询不可见的问题 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Android 11+ 包可见性: 让 app_launch 能解析第三方应用启动入口 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="Nyral"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.Material.Light" android:networkSecurityConfig="@xml/network_security_config">

        <!-- 首启引导页作为 launcher：全新安装先看引导，点"开始授权"后进主界面 -->
        <activity
            android:name=".GuideActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 主界面：由引导页或系统通知等跳入，不再直接响应桌面图标 -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
        </activity>

        <!-- 任务执行前台服务: AI 处理任务期间防止进程被回收, dataSync 类型 -->
        <service
            android:name=".TaskService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 无障碍控制服务: AI 控制第三方 App 的原型通道, 需用户在系统设置开启无障碍 -->
        <service
            android:name=".UiControlService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- 设置系页面统一 NoActionBar：自绘白色标题栏（Ui.titleBar），与主页视觉一致 -->
        <activity
            android:name=".SshConfigActivity"
            android:exported="false"
            android:label="SSH 连接配置"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="设置"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!-- 头像 1:1 自由裁剪页 -->
        <activity
            android:name=".AvatarCropActivity"
            android:exported="false"
            android:label="裁剪头像"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <activity
            android:name=".ModelConfigActivity"
            android:exported="false"
            android:label="模型配置"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <activity
            android:name=".ModelEditActivity"
            android:exported="false"
            android:label="添加模型"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <activity
            android:name=".MemModelConfigActivity"
            android:exported="false"
            android:label="记忆辅助模型"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <activity
            android:name=".MemoryListActivity"
            android:exported="false"
            android:label="长期记忆"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <activity
            android:name=".FileListActivity"
            android:exported="false"
            android:label="文件管理"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <activity
            android:name=".MemorySummaryActivity"
            android:exported="false"
            android:label="整理记忆索引"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <activity
            android:name=".LogActivity"
            android:exported="false"
            android:label="运行日志"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="关于"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!-- 权限管理: 查看/补开全部依赖权限 -->
        <activity
            android:name=".PermissionsActivity"
            android:exported="false"
            android:label="权限管理"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <activity
            android:name=".FirstRunSetupActivity"
            android:exported="false"
            android:label="完成授权与设置"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />



        <activity
            android:name=".ChatBackgroundActivity"
            android:exported="false"
            android:label="聊天背景"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!-- 附件持久化访问: 通过 content:// 让系统查看器打开 app 私有目录里的附件文件 -->
        <provider
            android:name=".LocalFileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true" />
        <activity
            android:name=".PersonalityActivity"
            android:exported="false"
            android:label="AI 个性化"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />
        <activity
            android:name=".AppearanceActivity"
            android:exported="false"
            android:label="外观设置"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <activity
            android:name=".McpConfigActivity"
            android:exported="false"
            android:label="MCP 服务"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!-- AI 悬浮迷你终端前台服务: 半透明终端实时显示 AI 执行状态 -->
        <service
            android:name=".AITerminalService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>
</manifest>
